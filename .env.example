# ─────────────────────────────────────────────
# DATABASE — Turso Cloud
# ─────────────────────────────────────────────
DATABASE_URL="libsql://your-database.turso.io"
DATABASE_AUTH_TOKEN="your-turso-auth-token"

# For self-hosted sqld (local/LAN):
# DATABASE_URL="http://localhost:8080"
# DATABASE_AUTH_TOKEN=""

# ─────────────────────────────────────────────
# AUTHENTICATION
# ─────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET="change-this-to-a-64-character-random-secret-string-before-production"

# ─────────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────────
NODE_ENV="development"
BASE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Company ERP"
NEXT_PUBLIC_APP_VERSION="1.0.0"

# ─────────────────────────────────────────────
# FILE UPLOADS
# ─────────────────────────────────────────────
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB="10"

# ─────────────────────────────────────────────
# SECURITY
# ─────────────────────────────────────────────
# Set to "true" only on public HTTPS deployments
FORCE_HTTPS="false"
