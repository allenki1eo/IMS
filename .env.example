# ---------------------------------------------------------------------------
# DATABASE - Turso (libSQL/SQLite)
# ---------------------------------------------------------------------------
# Cloud (Turso):
#   turso db show <db-name> --url        -> DATABASE_URL
#   turso db tokens create <db-name>     -> DATABASE_AUTH_TOKEN
DATABASE_URL="libsql://your-db.turso.io"
DATABASE_AUTH_TOKEN="your-turso-auth-token"

# Local development (SQLite file, no auth token needed):
# DATABASE_URL="file:./dev.db"
# DATABASE_AUTH_TOKEN=""
# Note: Prisma CLI stores relative file: URLs under prisma/ (e.g. prisma/dev.db).
# src/lib/db.ts resolves the same URL at runtime so app/seed hit that file.

# ---------------------------------------------------------------------------
# AUTHENTICATION
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 64
JWT_SECRET="change-this-to-a-64-character-random-secret-string-before-production"

# ---------------------------------------------------------------------------
# APPLICATION
# ---------------------------------------------------------------------------
NODE_ENV="development"
BASE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Company ERP"
NEXT_PUBLIC_APP_VERSION="1.0.0"

# ---------------------------------------------------------------------------
# FILE UPLOADS
# ---------------------------------------------------------------------------
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB="10"

# ---------------------------------------------------------------------------
# SECURITY
# ---------------------------------------------------------------------------
# Set to "true" only on public HTTPS deployments
FORCE_HTTPS="false"

# ---------------------------------------------------------------------------
# EXCHANGE RATES
# ---------------------------------------------------------------------------
# Get a free API key at https://app.exchangerate-api.com/
# Supports all currencies including TZS, KES, UGX, RWF, USD, EUR, GBP, etc.
EXCHANGERATE_API_KEY="your-exchangerate-api-key"

# ---------------------------------------------------------------------------
# FINANCE SMS (SwalaSMS — https://swalasms.com)
# ---------------------------------------------------------------------------
# Create an API key in the Swala portal (sandbox for tests, live for production).
# Never commit real tokens. Phone numbers are stored in app settings (Finance SMS).
SWALA_SMS_API_KEY="your-swala-api-key"
SWALA_SMS_SENDER_ID="YOURID"
# Optional override (default https://swalasms.com/api/v1)
# SWALA_SMS_BASE_URL="https://swalasms.com/api/v1"

# Cron auth for /api/cron/finance-eod-sms (Bearer or ?secret=)
CRON_SECRET="generate-a-long-random-secret"

# EOD SMS hour window in Africa/Dar_es_Salaam (inclusive). Default 18–20.
# FINANCE_EOD_SMS_HOUR_START="18"
# FINANCE_EOD_SMS_HOUR_END="20"
