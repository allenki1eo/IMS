# ---------------------------------------------------------------------------
# DATABASE - Supabase Postgres
# ---------------------------------------------------------------------------
# IMPORTANT FOR PERFORMANCE: DATABASE_URL must use the Transaction Pooler (port 6543).
# Using the direct connection (port 5432) for DATABASE_URL causes a new PostgreSQL
# connection on every serverless/Next.js request, which is extremely slow.
#
# In Supabase Dashboard → Project Settings → Database → Connection string
# Copy the "Transaction pooler" URL (mode=transaction, port 6543).
#
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Migration/direct connection. Prisma migrations need the direct URL (DDL doesn't work via pooler).
# In Supabase Dashboard → Project Settings → Database → Connection string → Direct connection
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

# Optional Supabase public values, useful if you later add Supabase Storage/Auth.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ---------------------------------------------------------------------------
# AUTHENTICATION
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 64
JWT_SECRET="change-this-to-a-64-character-random-secret-string-before-production"

# ---------------------------------------------------------------------------
# APPLICATION
# ---------------------------------------------------------------------------
NODE_ENV="development"
BASE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Company ERP"
NEXT_PUBLIC_APP_VERSION="1.0.0"

# ---------------------------------------------------------------------------
# FILE UPLOADS
# ---------------------------------------------------------------------------
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB="10"

# ---------------------------------------------------------------------------
# SECURITY
# ---------------------------------------------------------------------------
# Set to "true" only on public HTTPS deployments
FORCE_HTTPS="false"

# ---------------------------------------------------------------------------
# EXCHANGE RATES
# ---------------------------------------------------------------------------
# Get a free API key at https://app.exchangerate-api.com/
# Supports all currencies including TZS, KES, UGX, RWF, USD, EUR, GBP, etc.
EXCHANGERATE_API_KEY="your-exchangerate-api-key"
