# ---------------------------------------------------------------------------
# DATABASE - Turso (libSQL/SQLite)
# ---------------------------------------------------------------------------
# Cloud (Turso):
#   turso db show <db-name> --url        -> DATABASE_URL
#   turso db tokens create <db-name>     -> DATABASE_AUTH_TOKEN
DATABASE_URL="libsql://your-db.turso.io"
DATABASE_AUTH_TOKEN="your-turso-auth-token"

# Local development (SQLite file, no auth token needed):
# DATABASE_URL="file:./dev.db"
# DATABASE_AUTH_TOKEN=""

# ---------------------------------------------------------------------------
# AUTHENTICATION
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 64
JWT_SECRET="change-this-to-a-64-character-random-secret-string-before-production"

# ---------------------------------------------------------------------------
# APPLICATION
# ---------------------------------------------------------------------------
NODE_ENV="development"
BASE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Company ERP"
NEXT_PUBLIC_APP_VERSION="1.0.0"

# ---------------------------------------------------------------------------
# FILE UPLOADS
# ---------------------------------------------------------------------------
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB="10"

# ---------------------------------------------------------------------------
# SECURITY
# ---------------------------------------------------------------------------
# Set to "true" only on public HTTPS deployments
FORCE_HTTPS="false"

# ---------------------------------------------------------------------------
# EXCHANGE RATES
# ---------------------------------------------------------------------------
# Get a free API key at https://app.exchangerate-api.com/
# Supports all currencies including TZS, KES, UGX, RWF, USD, EUR, GBP, etc.
EXCHANGERATE_API_KEY="your-exchangerate-api-key"
