generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// COMPANY STRUCTURE
// ─────────────────────────────────────────────

model Company {
  id                 String   @id @default(cuid())
  name               String
  legalName          String?
  registrationNumber String?
  taxNumber          String?
  address            String?
  city               String?
  country            String?
  phone              String?
  email              String?
  website            String?
  logoPath           String?
  currency           String   @default("TZS")
  dateFormat         String   @default("YYYY-MM-DD")
  fiscalYearStart    Int      @default(1)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  branches    Branch[]
  departments Department[]
  employees   Employee[]
  settings    Setting[]
  customers   Customer[]
  salesOrders SalesOrder[]
  salesKpis   SalesKPI[]
  dailyMovements DailyTruckMovement[]

  @@map("companies")
}

model Branch {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  code        String   @unique
  address     String?
  city        String?
  phone       String?
  email       String?
  managerId   String?
  isMain      Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String

  company     Company      @relation(fields: [companyId], references: [id])
  departments Department[]
  employees   Employee[]
  userRoles   UserRole[]
  warehouses  Warehouse[]

  @@index([companyId])
  @@map("branches")
}

model Department {
  id             String   @id @default(cuid())
  companyId      String
  branchId       String?
  name           String
  code           String   @unique
  description    String?
  parentId       String?
  headEmployeeId String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdById    String

  company    Company      @relation(fields: [companyId], references: [id])
  branch     Branch?      @relation(fields: [branchId], references: [id])
  parent     Department?  @relation("DeptHierarchy", fields: [parentId], references: [id])
  children   Department[] @relation("DeptHierarchy")
  employees  Employee[]

  @@index([companyId])
  @@index([branchId])
  @@map("departments")
}

// ─────────────────────────────────────────────
// USERS, ROLES & PERMISSIONS
// ─────────────────────────────────────────────

model User {
  id                 String    @id @default(cuid())
  employeeId         String?
  username           String    @unique
  email              String    @unique
  passwordHash       String
  fullName           String
  phone              String?
  avatarPath         String?
  isActive           Boolean   @default(true)
  isSystemUser       Boolean   @default(false)
  mustChangePassword Boolean   @default(true)
  lastLoginAt        DateTime?
  passwordChangedAt  DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  createdById        String?

  roles    UserRole[]
  sessions Session[]
  employee Employee? @relation(fields: [employeeId], references: [id])

  @@index([isActive])
  @@map("users")
}

model Role {
  id           String   @id @default(cuid())
  name         String   @unique
  code         String   @unique
  description  String?
  isSystemRole Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdById  String?

  permissions   RolePermission[]
  userRoles     UserRole[]
  approvalSteps ApprovalWorkflowStep[]

  @@map("roles")
}

model Permission {
  id          String @id @default(cuid())
  module      String
  resource    String
  action      String
  description String?

  rolePermissions RolePermission[]

  @@unique([module, resource, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  grantedAt    DateTime @default(now())
  grantedById  String

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id           String    @id @default(cuid())
  userId       String
  roleId       String
  branchId     String?
  assignedAt   DateTime  @default(now())
  assignedById String
  expiresAt    DateTime?

  user   User    @relation(fields: [userId], references: [id])
  role   Role    @relation(fields: [roleId], references: [id])
  branch Branch? @relation(fields: [branchId], references: [id])

  @@unique([userId, roleId, branchId])
  @@map("user_roles")
}

// ─────────────────────────────────────────────
// SESSIONS
// ─────────────────────────────────────────────

model Session {
  id             String    @id @default(cuid())
  userId         String
  tokenHash      String    @unique
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  lastActivityAt DateTime  @default(now())
  isActive       Boolean   @default(true)
  revokedAt      DateTime?
  revokedReason  String?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([isActive, expiresAt])
  @@map("sessions")
}

// ─────────────────────────────────────────────
// EMPLOYEES
// ─────────────────────────────────────────────

model Employee {
  id              String   @id @default(cuid())
  companyId       String
  branchId        String?
  departmentId    String?
  employeeNumber  String   @unique
  firstName       String
  lastName        String
  fullName        String
  email           String?
  phone           String?
  position        String?
  employmentType  String   @default("PERMANENT")
  status          String   @default("ACTIVE")
  hireDate        DateTime?
  terminationDate DateTime?
  isDriver        Boolean  @default(false)
  source          String   @default("MANUAL")
  hrEmployeeId    String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdById     String

  company    Company     @relation(fields: [companyId], references: [id])
  branch     Branch?     @relation(fields: [branchId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  users      User[]
  driver     Driver?

  @@index([companyId])
  @@index([status])
  @@index([branchId])
  @@index([departmentId])
  @@map("employees")
}

// ─────────────────────────────────────────────
// SETTINGS
// ─────────────────────────────────────────────

model Setting {
  id          String   @id @default(cuid())
  companyId   String
  key         String   @unique
  value       String
  category    String   @default("general")
  description String?
  isPublic    Boolean  @default(false)
  updatedAt   DateTime @updatedAt
  updatedById String

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([category])
  @@map("settings")
}

// ─────────────────────────────────────────────
// AUDIT LOGS
// ─────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(cuid())
  companyId   String?
  branchId    String?
  userId      String?
  userName    String
  action      String
  module      String
  resource    String
  recordId    String?
  oldValue    String?
  newValue    String?
  description String?
  ipAddress   String?
  userAgent   String?
  sessionId   String?
  createdAt   DateTime @default(now())

  @@index([module, resource])
  @@index([userId])
  @@index([recordId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────
// APPROVAL SYSTEM
// ─────────────────────────────────────────────

model ApprovalWorkflow {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  module      String
  resource    String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String

  steps    ApprovalWorkflowStep[]
  requests ApprovalRequest[]

  @@unique([companyId, module, resource])
  @@map("approval_workflows")
}

model ApprovalWorkflowStep {
  id              String  @id @default(cuid())
  workflowId      String
  stepNumber      Int
  name            String
  description     String?
  approverType    String  @default("ANY_OF_ROLE")
  approverRoleId  String?
  approverUserId  String?
  canDelegate     Boolean @default(false)
  timeLimitHours  Int?

  workflow ApprovalWorkflow @relation(fields: [workflowId], references: [id])
  role     Role?            @relation(fields: [approverRoleId], references: [id])

  @@unique([workflowId, stepNumber])
  @@map("approval_workflow_steps")
}

model ApprovalRequest {
  id              String    @id @default(cuid())
  companyId       String
  workflowId      String
  module          String
  resource        String
  recordId        String
  recordReference String
  requestedById   String
  requestedAt     DateTime  @default(now())
  currentStep     Int       @default(1)
  status          String    @default("PENDING")
  priority        String    @default("NORMAL")
  notes           String?
  resolvedAt      DateTime?
  resolvedById    String?

  workflow ApprovalWorkflow @relation(fields: [workflowId], references: [id])
  actions  ApprovalAction[]

  @@index([module, resource, recordId])
  @@index([requestedById])
  @@index([status])
  @@map("approval_requests")
}

model ApprovalAction {
  id             String   @id @default(cuid())
  requestId      String
  stepNumber     Int
  action         String
  actedById      String
  actedAt        DateTime @default(now())
  comments       String?
  nextApproverId String?

  request ApprovalRequest @relation(fields: [requestId], references: [id])

  @@map("approval_actions")
}

// ─────────────────────────────────────────────
// WAREHOUSE MANAGEMENT
// ─────────────────────────────────────────────

model Warehouse {
  id          String   @id @default(cuid())
  companyId   String
  branchId    String?
  name        String
  code        String
  address     String?
  warehouseType String @default("MAIN")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String

  branch        Branch?             @relation(fields: [branchId], references: [id])
  locations     StorageLocation[]
  stockBalances StockBalance[]
  stockLedger   StockLedger[]
  grns          GoodsReceivedNote[]
  fromTransfers StockTransfer[]     @relation("TransferFrom")
  toTransfers   StockTransfer[]     @relation("TransferTo")
  adjustments   StockAdjustment[]
  fgLots        FGLot[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("warehouses")
}

model StorageLocation {
  id           String   @id @default(cuid())
  warehouseId  String
  parentId     String?
  name         String
  code         String
  locationType String   @default("AREA")
  capacity     Float?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  warehouse     Warehouse         @relation(fields: [warehouseId], references: [id])
  parent        StorageLocation?  @relation("LocationHierarchy", fields: [parentId], references: [id])
  children      StorageLocation[] @relation("LocationHierarchy")
  stockBalances StockBalance[]
  grnLines      GRNLine[]
  adjustLines   StockAdjustmentLine[]
  fromLines     StockTransferLine[] @relation("TransferLineFrom")
  toLines       StockTransferLine[] @relation("TransferLineTo")

  @@unique([warehouseId, code])
  @@map("storage_locations")
}

model ItemCategory {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  code        String
  description String?
  parentId    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  parent   ItemCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children ItemCategory[] @relation("CategoryHierarchy")
  items    Item[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("item_categories")
}

model UnitOfMeasure {
  id        String   @id @default(cuid())
  companyId String
  name      String
  code      String
  symbol    String
  isBase    Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  items Item[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("units_of_measure")
}

model Item {
  id           String   @id @default(cuid())
  companyId    String
  code         String
  name         String
  description  String?
  categoryId   String?
  uomId        String
  itemType     String   @default("RAW_MATERIAL")
  minStock     Float    @default(0)
  maxStock     Float?
  reorderPoint Float?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdById  String

  category        ItemCategory?       @relation(fields: [categoryId], references: [id])
  uom             UnitOfMeasure       @relation(fields: [uomId], references: [id])
  stockBalances   StockBalance[]
  stockLedger     StockLedger[]
  grnLines        GRNLine[]
  transferLines   StockTransferLine[]
  adjustmentLines StockAdjustmentLine[]
  qualityStandards QualityStandard[]
  qualityTests    QualityTest[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([categoryId])
  @@index([isActive])
  @@map("items")
}

model StockBalance {
  id          String   @id @default(cuid())
  itemId      String
  warehouseId String
  locationId  String?
  quantity    Float    @default(0)
  updatedAt   DateTime @updatedAt

  item      Item             @relation(fields: [itemId], references: [id])
  warehouse Warehouse        @relation(fields: [warehouseId], references: [id])
  location  StorageLocation? @relation(fields: [locationId], references: [id])

  @@unique([itemId, warehouseId, locationId])
  @@index([warehouseId])
  @@index([itemId])
  @@map("stock_balances")
}

model StockLedger {
  id              String   @id @default(cuid())
  companyId       String
  itemId          String
  warehouseId     String
  locationId      String?
  transactionType String
  quantity        Float
  balanceAfter    Float
  unitCost        Float?
  totalCost       Float?
  referenceType   String?
  referenceId     String?
  notes           String?
  createdById     String
  createdAt       DateTime @default(now())

  item      Item      @relation(fields: [itemId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@index([itemId, warehouseId])
  @@index([referenceType, referenceId])
  @@index([createdAt])
  @@map("stock_ledger")
}

model GoodsReceivedNote {
  id           String    @id @default(cuid())
  companyId    String
  warehouseId  String
  reference    String    @unique
  supplierName String?
  supplierRef  String?
  status       String    @default("DRAFT")
  notes        String?
  receivedById String
  receivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdById  String

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  lines     GRNLine[]

  @@index([companyId])
  @@index([status])
  @@index([warehouseId])
  @@index([companyId, createdAt])
  @@map("goods_received_notes")
}

model GRNLine {
  id         String  @id @default(cuid())
  grnId      String
  itemId     String
  locationId String?
  quantity   Float
  unitCost   Float?
  totalCost  Float?
  notes      String?

  grn      GoodsReceivedNote @relation(fields: [grnId], references: [id])
  item     Item               @relation(fields: [itemId], references: [id])
  location StorageLocation?   @relation(fields: [locationId], references: [id])

  @@map("grn_lines")
}

model StockTransfer {
  id              String    @id @default(cuid())
  companyId       String
  fromWarehouseId String
  toWarehouseId   String
  reference       String    @unique
  status          String    @default("DRAFT")
  notes           String?
  dispatchedAt    DateTime?
  receivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdById     String

  fromWarehouse Warehouse         @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse         @relation("TransferTo", fields: [toWarehouseId], references: [id])
  lines         StockTransferLine[]

  @@index([companyId])
  @@index([status])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@map("stock_transfers")
}

model StockTransferLine {
  id             String  @id @default(cuid())
  transferId     String
  itemId         String
  fromLocationId String?
  toLocationId   String?
  quantity       Float

  transfer     StockTransfer    @relation(fields: [transferId], references: [id])
  item         Item              @relation(fields: [itemId], references: [id])
  fromLocation StorageLocation?  @relation("TransferLineFrom", fields: [fromLocationId], references: [id])
  toLocation   StorageLocation?  @relation("TransferLineTo", fields: [toLocationId], references: [id])

  @@map("stock_transfer_lines")
}

model StockAdjustment {
  id                String    @id @default(cuid())
  companyId         String
  warehouseId       String
  reference         String    @unique
  reason            String
  notes             String?
  status            String    @default("DRAFT")
  approvalRequestId String?
  submittedAt       DateTime?
  appliedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  createdById       String

  warehouse Warehouse             @relation(fields: [warehouseId], references: [id])
  lines     StockAdjustmentLine[]

  @@index([companyId])
  @@index([status])
  @@index([warehouseId])
  @@map("stock_adjustments")
}

model StockAdjustmentLine {
  id           String  @id @default(cuid())
  adjustmentId String
  itemId       String
  locationId   String?
  systemQty    Float
  countedQty   Float
  difference   Float

  adjustment StockAdjustment  @relation(fields: [adjustmentId], references: [id])
  item       Item               @relation(fields: [itemId], references: [id])
  location   StorageLocation?   @relation(fields: [locationId], references: [id])

  @@map("stock_adjustment_lines")
}

// ─────────────────────────────────────────────
// TRANSPORT & FLEET
// ─────────────────────────────────────────────

model Vehicle {
  id               String    @id @default(cuid())
  companyId        String
  branchId         String?
  plateNumber      String    @unique
  make             String
  model            String
  year             Int?
  vehicleType      String    @default("TRUCK")
  usageType        String    @default("COMMERCIAL")
  capacity         Float?
  fuelType         String    @default("DIESEL")
  fuelTankCapacity Float?
  color            String?
  chassisNumber    String?
  engineNumber     String?
  odometer         Float     @default(0)
  status           String    @default("ACTIVE")
  insuranceExpiry  DateTime?
  roadWorthyExpiry DateTime?
  lastServiceDate  DateTime?
  nextServiceDate  DateTime?
  lastRefuelAt     DateTime?
  nextRefuelAt     DateTime?
  averageConsumption Float?
  isActive         Boolean   @default(true)
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdById      String

  assignments        VehicleAssignment[]
  trips              TripOrder[]
  trailedTrips       TripOrder[] @relation("TripOrderTrailer")
  incidents          VehicleIncident[]
  documents          VehicleDocument[]
  fuelIssues         FuelIssue[]
  maintenanceSchedules MaintenanceSchedule[]
  workOrders         WorkOrder[]
  dispatchOrders     DispatchOrder[]
  dailyMovementEntries DailyTruckMovementEntry[]

  @@index([companyId])
  @@index([status])
  @@map("vehicles")
}

model VehicleDocument {
  id             String    @id @default(cuid())
  vehicleId      String
  documentType   String
  documentNumber String?
  issuedAt       DateTime?
  expiresAt      DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  createdById    String

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@map("vehicle_documents")
}

model Driver {
  id            String    @id @default(cuid())
  companyId     String
  employeeId    String?   @unique
  firstName     String?
  lastName      String?
  phone         String?
  email         String?
  licenseNumber String?
  licenseClass  String?
  licenseExpiry DateTime?
  medicalExpiry DateTime?
  isAvailable   Boolean   @default(true)
  status        String    @default("ACTIVE")
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdById   String

  employee       Employee?           @relation(fields: [employeeId], references: [id])
  assignments    VehicleAssignment[]
  trips          TripOrder[]
  fuelIssues     FuelIssue[]
  dispatchOrders DispatchOrder[]
  dailyMovementEntries DailyTruckMovementEntry[]

  @@index([companyId])
  @@index([status])
  @@index([isAvailable])
  @@map("drivers")
}

model VehicleAssignment {
  id           String    @id @default(cuid())
  vehicleId    String
  driverId     String
  assignedById String
  assignedAt   DateTime  @default(now())
  returnedAt   DateTime?
  status       String    @default("ACTIVE")
  notes        String?

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  driver  Driver  @relation(fields: [driverId], references: [id])

  @@index([vehicleId])
  @@index([driverId])
  @@map("vehicle_assignments")
}

model TripOrder {
  id                 String    @id @default(cuid())
  companyId          String
  branchId           String?
  reference          String    @unique
  vehicleId          String?
  driverId           String?
  origin             String
  destination        String
  scheduledDeparture DateTime?
  scheduledArrival   DateTime?
  actualDeparture    DateTime?
  actualArrival      DateTime?
  trailerId          String?
  cargoDescription   String?
  cargoWeight        Float?
  currentLocation    String?
  status             String    @default("PLANNED")
  priority           String    @default("NORMAL")
  approvalRequestId  String?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  createdById        String

  vehicle   Vehicle?          @relation(fields: [vehicleId], references: [id])
  trailer   Vehicle?          @relation("TripOrderTrailer", fields: [trailerId], references: [id])
  driver    Driver?           @relation(fields: [driverId], references: [id])
  logs                 TripLog[]
  cargo                TripCargo[]
  incidents            VehicleIncident[]
  dailyMovementEntries DailyTruckMovementEntry[]

  @@index([companyId])
  @@index([status])
  @@index([vehicleId])
  @@index([driverId])
  @@index([companyId, createdAt])
  @@map("trip_orders")
}

model TripLog {
  id           String   @id @default(cuid())
  tripId       String
  eventType    String
  eventTime    DateTime @default(now())
  location     String?
  odometer     Float?
  notes        String?
  recordedById String
  createdAt    DateTime @default(now())

  trip TripOrder @relation(fields: [tripId], references: [id])

  @@index([tripId])
  @@map("trip_logs")
}

model TripCargo {
  id            String  @id @default(cuid())
  tripId        String
  itemId        String?
  description   String
  quantity      Float?
  uom           String?
  referenceType String?
  referenceId   String?

  trip TripOrder @relation(fields: [tripId], references: [id])

  @@map("trip_cargo")
}

model VehicleIncident {
  id              String    @id @default(cuid())
  companyId       String
  vehicleId       String
  tripId          String?
  incidentType    String
  incidentDate    DateTime
  location        String?
  description     String
  reportedById    String
  status          String    @default("OPEN")
  resolutionNotes String?
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  vehicle Vehicle    @relation(fields: [vehicleId], references: [id])
  trip    TripOrder? @relation(fields: [tripId], references: [id])

  @@index([companyId])
  @@index([vehicleId])
  @@index([status])
  @@map("vehicle_incidents")
}

// ─────────────────────────────────────────────
// FUEL MANAGEMENT
// ─────────────────────────────────────────────

model FuelTank {
  id           String   @id @default(cuid())
  companyId    String
  branchId     String?
  name         String
  code         String   @unique
  fuelType     String   @default("DIESEL")
  capacity     Float
  currentLevel Float    @default(0)
  minLevel     Float    @default(0)
  isActive     Boolean  @default(true)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdById  String

  receipts FuelReceipt[]
  issues   FuelIssue[]

  @@index([companyId])
  @@map("fuel_tanks")
}

model FuelReceipt {
  id                 String    @id @default(cuid())
  companyId          String
  tankId             String
  reference          String    @unique
  supplierName       String?
  deliveryNoteRef    String?
  quantityLiters     Float
  pricePerLiter      Float?
  totalCost          Float?
  currency           String    @default("TZS")
  exchangeRate       Float?
  baseCurrencyAmount Float?
  status             String    @default("DRAFT")
  notes              String?
  receivedById       String
  receivedAt         DateTime?
