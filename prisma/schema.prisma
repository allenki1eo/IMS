  item       Item?                      @relation(fields: [itemId], references: [id])

  @@index([companyId])
  @@index([itemId])
  @@map("quality_standards")
}

model QualityStandardParameter {
  id          String  @id @default(cuid())
  standardId  String
  name        String
  unit        String?
  minValue    Float?
  maxValue    Float?
  targetValue Float?
  isRequired  Boolean @default(true)
  sortOrder   Int     @default(0)

  standard QualityStandard @relation(fields: [standardId], references: [id])

  @@index([standardId])
  @@map("quality_standard_parameters")
}

model QualityTest {
  id            String    @id @default(cuid())
  companyId     String
  reference     String    @unique
  standardId    String?
  itemId        String?
  productionBatchId String?
  batchNumber   String?
  testType      String
  testStage     String?
  samplePoint   String?
  status        String    @default("PENDING")
  result        String?
  releaseDecision String?
  releasedAt    DateTime?
  releasedById  String?
  requestedById String
  testedById    String?
  sampleQty     Float?
  sampleUnit    String?
  notes         String?
  testedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  standard        QualityStandard?     @relation(fields: [standardId], references: [id])
  item            Item?                @relation(fields: [itemId], references: [id])
  productionBatch ProductionBatch?      @relation(fields: [productionBatchId], references: [id])
  results         QualityTestResult[]
  nonConformances NonConformance[]

  @@index([companyId])
  @@index([standardId])
  @@index([itemId])
  @@index([productionBatchId])
  @@index([status])
  @@index([testStage])
  @@map("quality_tests")
}

model QualityTestResult {
  id            String  @id @default(cuid())
  testId        String
  parameterName String
  unit          String?
  minValue      Float?
  maxValue      Float?
  targetValue   Float?
  actualValue   Float?
  textResult    String?
  isPassed      Boolean?
  notes         String?

  test QualityTest @relation(fields: [testId], references: [id])

  @@index([testId])
  @@map("quality_test_results")
}

model NonConformance {
