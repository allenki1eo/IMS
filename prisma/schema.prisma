  correctiveAction String?
  reportedById     String
  assignedToId     String?
  resolvedAt       DateTime?
  closedAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  test QualityTest? @relation(fields: [testId], references: [id])

  @@index([companyId])
  @@index([testId])
  @@index([status])
  @@map("non_conformances")
}

