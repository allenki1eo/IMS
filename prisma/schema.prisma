// FINANCE OPERATIONS
// ─────────────────────────────────────────────

model Account {
  id              String  @id @default(cuid())
  companyId       String
  code            String
  name            String
  accountType     String  // ASSET, LIABILITY, EQUITY, REVENUE, EXPENSE
  parentId        String?
  description     String?
  openingBalance  Float   @default(0)
  currentBalance  Float   @default(0)
  isActive        Boolean @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  parent   Account?  @relation("AccountHierarchy", fields: [parentId], references: [id])
  children Account[] @relation("AccountHierarchy")
  lines    JournalEntryLine[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([accountType])
  @@index([isActive])
  @@map("accounts")
}

model JournalEntry {
  id          String   @id @default(cuid())
  companyId   String
  reference   String
  entryDate   DateTime @default(now())
  description String
  notes       String?
  voucherType String   @default("JOURNAL") // JOURNAL, PAYMENT, RECEIPT, CONTRA, SALES, PURCHASE, DEBIT_NOTE, CREDIT_NOTE
  status      String   @default("DRAFT") // DRAFT, POSTED, REVERSED
  totalDebit  Float    @default(0)
  totalCredit Float    @default(0)
  currency    String   @default("TZS")
  exchangeRate Float?
  createdById String
  postedAt    DateTime?
  reversedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

